<div class="pagefind">
  <pagefind-config
    base-url="{{ "/" | url }}"
    bundle-path="{{ "/assets/search/pagefind/" | url }}"
    faceted
    preload
  ></pagefind-config>

  <quick-search-button style="display: block;">
    <wa-tooltip for="search-trigger">
      Search this site (CMD+K)
    </wa-tooltip>
    <wa-button id="search-trigger" appearance="plain">
      <wa-icon
        style="font-size: 1.5em;
        color: light-dark(black, var(--wa-color-brand));"
        name="magnifying-glass"
        label="Search"
      ></wa-icon>
      <!-- <kbd>CMD+K</kbd> -->
    </wa-button>
  </quick-search-button>

  <pagefind-modal>
    <pagefind-modal-header>
      <pagefind-input></pagefind-input>
    </pagefind-modal-header>
    <pagefind-modal-body>
      <pagefind-summary></pagefind-summary>
      <pagefind-results>
        <script type="text/pagefind-template">
          {% raw %}
            <li class="pagefind-result">
              <h3 class="pagefind-result-heading">{{ meta.title }}</h3>
              <p class="pagefind-result-excerpt">{{+ excerpt +}}</p>
              <a href="{{ url | safeUrl }}">{{ url }}</a>
            </li>
          {% endraw %}
        </script>
      </pagefind-results>
    </pagefind-modal-body>
    <pagefind-modal-footer>
      <pagefind-keyboard-hints></pagefind-keyboard-hints>
    </pagefind-modal-footer>
  </pagefind-modal>
</div>
