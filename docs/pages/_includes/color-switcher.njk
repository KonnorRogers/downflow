<div class="color-switcher" flow-controller="color-switcher">
  <label class="light-label">
    <wa-icon name="sun"></wa-icon>
    <input
      name="color-switch"
      value="light"
      type="radio"
      flow-prop="checked:!!color.light"
      flow-action="
        click->#color.switchMode
        change->#color.switchMode
      "
    >
    <span class="wa-visually-hidden">Switch to light mode</span>
  </label>

  <label class="dark-label">
    <!-- 0.3em is "optical center" so it doesn't look wrong. -->
    <wa-icon
      name="moon"
      style="padding-inline-start: 0.3em;"
    >
    </wa-icon>
    <input
      name="color-switch"
      value="dark"
      type="radio"
      flow-prop="checked:!!color.dark"
      flow-action="
        click->#color.switchMode
        change->#color.switchMode
      "
    >
    <span class="wa-visually-hidden">Switch to dark mode</span>
  </label>
</div>
