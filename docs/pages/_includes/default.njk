<!DOCTYPE html>
<html lang="en">
  <head>
    {% block head %}
      {% include "head.njk" %}
    {% endblock %}
    <link rel="modulepreload" href="{{ "/assets/search/pagefind/pagefind.js" | url }}">
    {% for chunk in chunks %}
      <link rel="modulepreload" href="{{ chunk | url }}">
    {% endfor %}
  </head>
  <body>
    <!-- not sure why this needs to 30px smaller? maybe the auto injected nav button?? -->
    <wa-page class="layout-{{ layout | stripExtension }}" mobile-breakpoint="1200" style="--header-height: 83px;">
      {% block header %}
        {% include "header.njk" %}
      {% endblock %}
      {% block navigation %}
        {% include "sidebar.njk" %}
      {% endblock %}

      <div slot="aside">{% block aside %}{% endblock %}</div>

      <main class="content prose">
        {% block heading %}
        {% endblock %}
        {{ content | safe }}
      </main>

      <footer slot="main-footer" style="display: block;">
        {% block inline_footer %}
        {% endblock %}
      </footer>
    </wa-page>

  </body>
</html>
