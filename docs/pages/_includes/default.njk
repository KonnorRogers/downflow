<!DOCTYPE html>
<html lang="en">
  <head>
    {% block head %}
      {% include "head.njk" %}
    {% endblock %}
  </head>
  <body>
    <wa-page>
      {% block header %}
        {% include "header.njk" %}
      {% endblock %}
      {% block navigation %}
        {% include "sidebar.njk" %}
      {% endblock %}
      <main class="content">
        {% block heading %}
        {% endblock %}
        {{ content | safe }}
      </main>

      <footer slot="main-footer">
      </footer>
    </wa-page>
  </body>
</html>
