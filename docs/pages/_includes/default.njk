<!DOCTYPE html>
<html lang="en">
  <head>
    {% block head %}
      {% include "head.njk" %}
    {% endblock %}
  </head>
  <body>
    <wa-page>
      {% block navigation %}
        <aside slot="navigation">
          {%- for category in collections.docsByCategory -%}
            {%- if category.slug == category %}
              <ul>
                {% for doc in category.pages %}
                  <li>
                    <a href="{{ doc.url }}">{{ doc.data.title }}</a>
                  </li>
                {% endfor %}
              </ul>
            {%- endif -%}
          {%- endfor -%}
        </aside>
      {% endblock %}
      <main class="content">
        {% block heading %}
        {% endblock %}
        {{ content | safe }}
      </main>

      <footer slot="main-footer">
      </footer>
    </wa-page>
  </body>
</html>
